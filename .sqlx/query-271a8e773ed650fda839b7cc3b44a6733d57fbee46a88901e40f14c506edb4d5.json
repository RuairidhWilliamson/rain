  "db_name": "PostgreSQL",
  "query": "\n                SELECT\n                    id,\n                    repo as repo_id,\n                    commit,\n                    created_at,\n                    dequeued_at,\n                    rain_version,\n                    target,\n                    finished_at as \"finished_at?\",\n                    status as \"status?\",\n                    execution_time_millis as \"execution_time_millis?\",\n                    output as \"output?\"\n                FROM runs\n                LEFT OUTER JOIN finished_runs ON runs.id=finished_runs.run\n                WHERE runs.id=$1;\n                ",
