{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                runs.id,\n                repos.id as repo_id,\n                repos.host_api,\n                repos.host_url,\n                repos.owner,\n                repos.name,\n                commit,\n                created_at,\n                dequeued_at,\n                rain_version,\n                target,\n                finished_at as \"finished_at?\",\n                status as \"status?\",\n                execution_time_millis as \"execution_time_millis?\",\n                output as \"output?\"\n            FROM runs\n            INNER JOIN repos ON runs.repo=repos.id\n            LEFT OUTER JOIN finished_runs ON runs.id=finished_runs.run\n            WHERE runs.id=$1;\n            ",
