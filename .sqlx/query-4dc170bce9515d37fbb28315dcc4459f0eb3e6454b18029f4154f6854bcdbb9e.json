{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                runs.id,\n                commit,\n                created_at,\n                dequeued_at,\n                rain_version,\n                repos.id AS repo_id,\n                repos.host_api,\n                repos.host_url,\n                repos.owner,\n                repos.name,\n                target,\n                finished_at AS \"finished_at?\",\n                status AS \"status?\",\n                execution_time_millis AS \"execution_time_millis?\",\n                output AS \"output?\"\n            FROM runs\n            INNER JOIN repos ON runs.repo=repos.id\n            LEFT OUTER JOIN finished_runs ON runs.id=finished_runs.run\n            ORDER BY runs.id DESC\n            OFFSET $1 LIMIT $2;\n            ",
