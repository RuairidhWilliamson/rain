{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                runs.id,\n                commit,\n                created_at,\n                dequeued_at,\n                rain_version,\n                repo AS repo_id,\n                target,\n                finished_at AS \"finished_at?\",\n                status AS \"status?\",\n                execution_time_millis AS \"execution_time_millis?\",\n                output AS \"output?\",\n                check_run_id\n            FROM runs\n            LEFT OUTER JOIN finished_runs ON runs.id=finished_runs.run\n            WHERE repo=$1\n            ORDER BY runs.id DESC\n            OFFSET $2 LIMIT $3;\n            ",
