let main = import("main.rain")
let std = main.std

let {File} = std.types

pub let build_ci_web = fn() -> File {
	std.build.rust.escape.cargo_build(main.area, {bin = "rain-ci-web", target = "x86_64-unknown-linux-musl", release = true})
}

pub let build_ci_migrator = fn() -> File {
	std.build.rust.escape.cargo_build(main.area, {bin = "rain-ci-migrator", target = "x86_64-unknown-linux-musl", release = true})
}

pub let build_ci_migrations = fn() -> File {
	std.compression.compress_tar_gz(std.fs.dir(main.area, "ci/migrations"), "rain-ci-migrations.tar.gz")
}

pub let build_ci_coordinator = fn() -> File {
	std.build.rust.escape.cargo_build(main.area, {bin = "rain-ci-coordinator", target = "x86_64-unknown-linux-gnu", release = true})
}
