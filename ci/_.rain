let main = import("main.rain")
let std = main.std

let {Area, File, String, Dir} = std.types

let podman = std.escape.bin("podman")

pub let build_ci_web = fn() -> File {
	std.build.rust.escape.cargo_build(main.area, "rain-ci-web", "x86_64-unknown-linux-musl", true)
}

pub let build_ci_migrator = fn() -> File {
	std.build.rust.escape.cargo_build(main.area, "rain-ci-migrator", "x86_64-unknown-linux-musl", true)
}

let migrations_dir = std.fs.relative_dir("migrations")

pub let build_ci_migrations = fn() -> File {
	std.compression.compress_tar_gz(migrations_dir, "migrations.tar.gz")
}

pub let build_ci_coordinator = fn() -> File {
	std.build.rust.escape.cargo_build(main.area, "rain-ci-coordinator", "x86_64-unknown-linux-gnu", true)
}
