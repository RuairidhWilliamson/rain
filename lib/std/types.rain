let get_type = internal._get_type
let fold = internal._fold

let concrete_types = internal._concrete_types()

let throw_type = fn() {
	internal._throw("type error")
}

let bool_type_checker = fn(old) {
	fn(v) {
		if old(v) {
			v
		} else {
			throw_type()
		}
	}
}

pub let check_type = fn(v: Any, type_constraint: Type) -> Any {
	if get_type(type_constraint) == get_type(Unit) {
		if get_type(v) == type_constraint {
			v
		} else {
			throw_type()
		}
	} else {
		type_constraint(v)
	}
}

pub let Any = fn(v) { v }
pub let Never = fn(v) { throw_type() }

// A type constraint is currently equivalent to a type
pub let TypeConstraint = Type
pub let Type = bool_type_checker(fn(v) {
	// A type is either a concrete type or a function
	get_type(v) == get_type(Unit) || get_type(v) == get_type(Any)
})

pub let Unit = get_type(internal._unit())
pub let Bool = get_type(false)
pub let Integer = get_type(0)
pub let String = get_type("")
pub let AnyRecord = get_type({})
pub let AnyList = get_type([])

pub let GeneratedArea = concrete_types.generated_fs_area
pub let LocalArea = concrete_types.local_fs_area
pub let Area = Either(GeneratedArea, LocalArea)
pub let GeneratedFile = concrete_types.generated_file
pub let GeneratedDir = concrete_types.generated_dir
pub let LocalFile = concrete_types.local_file
pub let LocalDir = concrete_types.local_dir
pub let File = Either(GeneratedFile, LocalFile)
pub let Dir = Either(GeneratedDir, LocalDir)
pub let DirLike = Either(Dir, Area)

pub let Either = fn(a: Type, b: Type) -> Type {
	Union([a, b])
}

pub let Union = fn(types: List(Type)) -> Type {
	fn(v: Any) {
		result = fold(false, types, fn(acc, x) {
			result = internal._try(fn() {
				check_type(v, x)
			})
			acc || result.success
		})
		if result {
			v
		} else {
			throw_type()
		}
	}
}

pub let PositiveInteger = bool_type_checker(fn(v: Any) -> Bool {
	check_type(v, Integer) && v > 0
})

pub let NonPositiveInteger = bool_type_checker(fn(v: Any) -> Bool {
	check_type(v, Integer) && v <= 0
})

pub let NonNegativeInteger = bool_type_checker(fn(v: Any) -> Bool {
	check_type(v, Integer) && v >= 0
})

pub let NegativeInteger = bool_type_checker(fn(v: Any) -> Bool {
	check_type(v, Integer) && v < 0
})

pub let List = fn(inner: Type) -> Type {
	internal._print(inner)
	internal._print(bool_type_checker(fn(v: Any) -> Bool {
		internal._print(get_type(v) == AnyList && fold(true, v, fn(acc, x) {
			acc && check_type(x, inner)
		}))
	}))
}

pub let Record = fn(inner: Type) -> Type {
	bool_type_checker(fn(v: Any) -> Bool {
		get_type(v) == AnyRecord && fold(true, internal._record_keys(v), fn(acc, x) {
			acc && check_type(internal._index(v, x), inner)
		})
	})
}

pub let new_interface = fn(fields: Record(Type)) -> Type {
	bool_type_checker(fn(v: Any) -> Bool {
		get_type(v) == AnyRecord && fold(true, internal._record_keys(fields), fn(acc, field_name) {
			type = internal._index(fields, field_name)
			result = internal._try(fn() {
				internal._index(v, field_name)
			})
			if result.success {
				acc && check_type(result.value, type)
			} else {
				false
			}
		})
	})
}

pub let new_optional_interface = fn(fields: Record(Type)) -> Type {
	bool_type_checker(fn(v: Any) -> Bool {
		get_type(v) == AnyRecord && fold(true, internal._record_keys(fields), fn(acc, field_name) {
			type = internal._index(fields, field_name)
			result = internal._try(fn() {
				internal._index(v, field_name)
			})
			if result.success {
				acc && check_type(result.value, type)
			} else {
				true
			}
		})
	})
}
