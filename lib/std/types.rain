let get_type = internal._get_type
let fold = internal._fold

let concrete_types = internal._concrete_types()

let throw_type = fn(expected, v) {
	res = internal._try(fn() {
		internal._stringify(v)
	})
	if res.success {
		internal._throw(f"type error for ${res.value}, expected ${expected}")
	} else {
		internal._throw(f"type error, expected ${expected}")
	}
}

let bool_type_checker = fn(old, expected) -> TypeConstraint {
	fn(v) {
		if !old(v) {
			throw_type(expected, v)
		}
	}
}

pub let Any = fn(v) {}
pub let Never = fn(v) { throw_type("never", v) }

// A type constraint is a function that takes a value and throws or returns nothing
pub let TypeConstraint = fn(v) {
	if get_type(v) != get_type(fn() {}) {
		throw_type("TypeConstraint", v)
	}
	// TODO: Check number of arguments, argument type and return type
}

let type_constraint_from_concrete = fn(conc) -> TypeConstraint {
	fn(v) {
		if get_type(v) != conc {
			throw_type(conc, v)
		}
	}
}

// A type is a concrete type
// let Type = bool_type_checker(fn(v) {
// 	get_type(v) == get_type(Unit)
// }, "Type")

pub let Unit: TypeConstraint = type_constraint_from_concrete(get_type(internal._unit()))
pub let Bool: TypeConstraint = type_constraint_from_concrete(get_type(false))
pub let Integer: TypeConstraint = type_constraint_from_concrete(get_type(0))
pub let String: TypeConstraint = type_constraint_from_concrete(get_type(""))
pub let AnyRecord: TypeConstraint = type_constraint_from_concrete(get_type({}))
pub let AnyList: TypeConstraint = type_constraint_from_concrete(get_type([]))

pub let GeneratedArea: TypeConstraint = type_constraint_from_concrete(concrete_types.generated_fs_area)
pub let LocalArea: TypeConstraint = type_constraint_from_concrete(concrete_types.local_fs_area)
pub let Area: TypeConstraint = Either(GeneratedArea, LocalArea)
pub let GeneratedFile: TypeConstraint = type_constraint_from_concrete(concrete_types.generated_file)
pub let GeneratedDir: TypeConstraint = type_constraint_from_concrete(concrete_types.generated_dir)
pub let LocalFile: TypeConstraint = type_constraint_from_concrete(concrete_types.local_file)
pub let LocalDir: TypeConstraint = type_constraint_from_concrete(concrete_types.local_dir)
pub let File: TypeConstraint = Either(GeneratedFile, LocalFile)
pub let Dir: TypeConstraint = Either(GeneratedDir, LocalDir)
pub let DirLike: TypeConstraint = Either(Dir, Area)

pub let Either = fn(a: TypeConstraint, b: TypeConstraint) -> TypeConstraint {
	Union([a, b])
}

pub let Union = fn(types: List(TypeConstraint)) -> TypeConstraint {
	fn(v: Any) {
		result = fold(false, types, fn(acc, x) {
			result = internal._try(fn() {
				x(v)
			})
			acc || result.success
		})
		if !result {
			throw_type("Union", v)
		}
	}
}

pub let PositiveInteger = bool_type_checker(fn(v: Any) -> Bool {
	Integer(v)
	v > 0
}, "PositiveInteger")

pub let NonPositiveInteger = bool_type_checker(fn(v: Any) -> Bool {
	Integer(v)
	v <= 0
}, "NonPositiveInteger")

pub let NonNegativeInteger = bool_type_checker(fn(v: Any) -> Bool {
	Integer(v)
	v >= 0
}, "NonNegativeInteger")

pub let NegativeInteger = bool_type_checker(fn(v: Any) -> Bool {
	Integer(v)
	v < 0
}, "NegativeInteger")

pub let List = fn(inner: TypeConstraint) -> TypeConstraint {
	fn(v: Any) {
		AnyList(v)
		fold(internal._unit(), v, fn(acc, x) {
			inner(x)
		})
	}
}

pub let Record = fn(inner: TypeConstraint) -> TypeConstraint {
	fn(v: Any) {
		AnyRecord(v)
		fold(internal._unit(), internal._record_keys(v), fn(acc, x) {
			inner(internal._index(v, x))
		})
	}
}

pub let new_interface = fn(fields: Record(TypeConstraint)) -> TypeConstraint {
	fn(v: Any) {
		AnyRecord(v)
		fold(internal._unit(), internal._record_keys(fields), fn(acc, field_name) {
			type = internal._index(fields, field_name)
			result = internal._try(fn() {
				internal._index(v, field_name)
			})
			if !result.success {
				internal._throw(f"missing field of record: ${field_name}")
			}
			type(result.value)
		})
	}
}

pub let new_optional_interface = fn(fields: Record(TypeConstraint)) -> TypeConstraint {
	fn(v: Any) {
		AnyRecord(v)
		fold(internal._unit(), internal._record_keys(fields), fn(acc, field_name) {
			type = internal._index(fields, field_name)
			result = internal._try(fn() {
				internal._index(v, field_name)
			})
			if result.success {
				type(result.value)
			}
		})
	}
}
