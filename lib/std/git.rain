let std = import("std.rain")
let {String, Bool, Area} = std.types

pub let status_commit = fn(area: Area) -> String {
	res = internal._git_describe(area)
	if res.exists {
		res.commit
	} else {
		""
	}
}

pub let dirty = fn(area: Area) -> Bool {
	res = internal._git_describe(area)
	if res.exists {
		res.dirty
	} else {
		""
	}
}
