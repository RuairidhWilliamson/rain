let std = import("std.rain")
let {unit} = std.utils
let {Any, List, Bool, Integer, String} = std.types

pub let fold = fn(initial: Any, list: List(Any), f) -> Any {
	internal._fold(initial, list, f)
}

pub let fold_enumerate = fn(initial: Any, list: List(Any), func) -> Any {
	{index, value} = fold({index = 0, value = initial}, list, fn(acc, x) {
		{index, acc} = acc
		new_value = func(acc, index, x)
		{index = index + 1, value = new_value}
	})
	value
}

pub let map = fn(list: List(Any), func) -> List(Any) {
	fold([], list, fn(acc, x) {
		acc + [func(x)]
	})
}

pub let filter = fn(list: List(Any), func) -> List(Any) {
	fold([], list, fn(acc, x) {
		if func(x) {
			acc + [x]
		} else {
			acc
		}
	})
}

pub let flatten = fn(list: List(List(Any))) -> List(Any) {
	fold([], list, fn(acc, x: List(Any)) {
		fold(acc, x, fn(inner_acc, inner) {
			inner_acc + [inner]
		})
	})
}

pub let all = fn(list: List(Bool)) -> Bool {
	fold(true, list, fn(acc, x: Bool) {
		acc && x
	})
}

pub let any = fn(list: List(Bool)) -> Bool {
	fold(false, list, fn(acc, x: Bool) {
		acc || x
	})
}

pub let count = fn(list: List(Any)) -> Integer {
	fold(0, list, fn(acc, x) {
		acc + 1
	})
}

pub let foreach = fn(list: List(Any), func) {
	fold(unit, list, fn(acc, x) {
		func(x)
		unit
	})
}

pub let concat = fn(a: List(Any), b: List(Any)) -> List(Any) {
	a + b
}

pub let join = fn(list: List(String), separator: String) -> String {
	fold("", list, fn(acc: String, x: String) -> String {
		if acc != "" {
			acc = acc + separator
		}
		acc = acc + x
		acc
	})
}

pub let first = head
pub let head = fn(list: List(Any)) -> Any {
	fold_enumerate(unit, list, fn(acc, i, v) {
		if i == 0 {
			v
		} else {
			acc
		}
	})
}

pub let tail = fn(list: List(Any)) -> List(Any) {
	fold_enumerate([], list, fn(acc, i, v) {
		if i == 0 {
			acc
		} else {
			acc + [v]
		}
	})
}

pub let last = fn(list: List(Any)) -> Any {
	fold(unit, list, fn(acc, x) {
		x
	})
}
