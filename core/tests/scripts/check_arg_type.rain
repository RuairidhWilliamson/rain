let main = fn() {}

let type_constraint_from_concrete = fn(conc) {
	fn(v) {
		if internal._get_type(v) != conc {
			internal._throw("bad type")
		}
	}
}

let bar = fn() {
	Integer = type_constraint_from_concrete(internal._get_type(0))
	String = type_constraint_from_concrete(internal._get_type(""))
	Bool = type_constraint_from_concrete(internal._get_type(false))
	foo = fn(a: Integer, b: String, c: Bool) {}
	foo(1, "banana", 9)
}
