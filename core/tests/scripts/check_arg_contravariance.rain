let main = fn() {}

let Integer = fn(v) {
	if internal._get_type(v) != internal._get_type(0) {
		internal._throw("not an integer")
	}
}

let String = fn(v) {
	if internal._get_type(v) != internal._get_type("") {
		internal._throw("not an string")
	}
}

let foo = fn(a: Integer) {
	bar(a)
}

let bar = fn(b: String) { }
